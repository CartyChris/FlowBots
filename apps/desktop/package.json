{
  "name": "@rakazo/desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/build-local-runtime.mjs && cp src/preload.cjs dist/preload.cjs",
    "pack": "pnpm build && electron-builder --mac --win --linux",
    "pack:mac": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --mac --universal",
    "pack:dir": "pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@composio/core": "0.16.0",
    "@e2b/desktop": "^2.3.1",
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@hono/node-server": "^1.19.1",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@rakazo/contracts": "workspace:*",
    "@rakazo/local-runtime": "workspace:*",
    "better-auth": "^1.6.27",
    "graphile-worker": "^0.17.3",
    "hono": "^4.9.6",
    "node-pty": "1.2.0-beta.14",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.rakazo.desktop",
    "productName": "FlowBots",
    "artifactName": "FlowBots-${version}-${arch}.${ext}",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../packages/db/prisma/migrations",
        "to": "migrations"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "**/node-pty/prebuilds/darwin-{arm64,x64}/**",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "FlowBots",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
